# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default  # Optional: Use if you have multiple AWS profiles

# NIST NVD API Configuration (Optional)
# Get your API key from: https://nvd.nist.gov/developers/request-an-api-key
# Without API key: 5 requests/30 seconds
# With API key: 50 requests/30 seconds
NVD_API_KEY=

# AWS Bedrock Model Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Alternative models you can use:
# anthropic.claude-3-5-sonnet-20240620-v1:0 (Recommended - best reasoning)
# anthropic.claude-3-opus-20240229-v1:0-v1:0 (Most capable, slower, more expensive)
# anthropic.claude-3-haiku-20240307-v1:0 (Fastest, cheapest, less thorough)
